{
  "name": "makram-arfaoui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "env:check": "tsx scripts/check-production-env.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:editor": "tsx scripts/e2e-editor.ts",
    "test:cache": "tsx scripts/e2e-cache.ts",
    "test:payments": "tsx scripts/e2e-payments.ts",
    "media:service-covers": "tsx --conditions react-server scripts/generate-service-covers.ts"
  },
  "prisma": {
    "seed": "tsx --conditions react-server prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.6",
    "@napi-rs/canvas": "^1.0.9",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.6",
    "file-type": "^22.1.1",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
