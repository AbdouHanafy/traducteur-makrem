// Schéma de référence : voir ARCHITECTURE.md §4 pour le raisonnement (Decimal pour l'argent,
// snapshot financier sur Order, historique append-only, idempotence des paiements par providerRef).
// Ce schéma sera étendu phase par phase (Phase 2: User/Role; Phase 3: Service/PricingRule;
// Phase 4-5: Order; Phase 6: Payment; Phase 8: Document; Phase 12: AuditLog).
// Non migré pour l'instant — nécessite une base MySQL configurée via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  DEMANDE
  DEVIS_A_VALIDER
  EN_ATTENTE_ACOMPTE
  ACOMPTE_PAYE
  EN_TRADUCTION
  TRADUCTION_TERMINEE
  FICHIER_EN_ATTENTE_DE_SOLDE
  SOLDE_PAYE
  TELECHARGEABLE
  TERMINEE
  ANNULEE
}

enum PaymentPhase {
  ADVANCE
  BALANCE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DocumentKind {
  SOURCE
  TRANSLATED
}

enum DocumentStatus {
  UPLOADED
  SCANNING
  READY
  REJECTED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Champs id/email/name/emailVerified/image : forme imposée par Better Auth (voir
// node_modules/@better-auth/core/src/db/schema/user.ts). role/firstName/lastName/phone
// sont nos additionalFields (src/lib/auth.ts) ; `password` n'est plus stocké ici — Better
// Auth le place dans Account.password (provider "credential"), voir §2 ARCHITECTURE.md.
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  emailVerified Boolean    @default(false)
  image         String?
  role          Role       @default(CLIENT)
  firstName     String
  lastName      String
  phone         String?
  /// Date d'acceptation des CGV et de la politique de confidentialité (inscription publique).
  termsAcceptedAt DateTime?
  /// Double authentification (TOTP) activée — obligatoire pour les administrateurs en production.
  twoFactorEnabled Boolean?  @default(false)
  twoFactors    TwoFactor[]
  orders        Order[]
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Tables Better Auth (générées pour correspondre à sa config — voir src/lib/auth.ts).
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @db.Text
  pricePerPage Decimal  @db.Decimal(10, 3)
  imageUrl     String? @db.VarChar(500)
  order        Int      @default(0)
  translations Json?
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PricingRule {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  multiplier Decimal? @db.Decimal(6, 3)
  flatFee    Decimal? @db.Decimal(10, 3)
  active     Boolean  @default(true)
}

// Backoffice — fondations (médiathèque, FAQ). Le page-builder de la home (sections
// réordonnables) et les articles viendront dans une itération suivante sur les mêmes bases.
model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  originalName String
  mimeType     String
  sizeBytes    Int
  altText      String?
  uploadedById String
  createdAt    DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  translations Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * Articles — même logique d'ordre manuel (monter/descendre) que FaqItem plutôt qu'un tri
 * chronologique implicite, pour rester cohérent avec ce que l'admin pilote ailleurs dans le
 * backoffice. `body` est du texte brut (paragraphes via retours à la ligne, voir
 * CustomSection) : pas d'éditeur riche dans cette itération.
 */
model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String    @db.Text
  body          String    @db.Text
  coverImageUrl String? @db.VarChar(500)
  order         Int       @default(0)
  published     Boolean   @default(false)
  translations  Json?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([order])
}

enum HomeSectionType {
  HERO
  STATS
  SERVICES
  WORKFLOW
  STATEMENT
  TESTIMONIALS
  FINAL_CTA
  CUSTOM
}

/**
 * Avis clients — jamais seedés avec du faux contenu (voir la discussion produit : publier de
 * faux avis attribués à des clients inventés serait trompeur sur un vrai site). La table est
 * vide par défaut ; le carrousel (TESTIMONIALS) ne s'affiche que s'il y a au moins un avis
 * actif, voir CustomSection/TestimonialsCarousel.
 */
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?
  quote      String   @db.Text
  rating     Int?
  order      Int      @default(0)
  active     Boolean  @default(true)
  translations Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

/**
 * Page-builder de la home — ordre et visibilité de toutes les sections (système + libres).
 * Les sections système (HERO, STATS, ...) gardent leur mise en page codée en dur (design de
 * marque, pas du contenu générique) : seuls order/visible sont pilotés d'ici. CUSTOM est le
 * seul type dont le contenu (eyebrow/title/body/image/CTA) est éditable depuis le backoffice —
 * c'est le mécanisme "ajouter une section" demandé.
 */
model HomeSection {
  id       String          @id @default(cuid())
  type     HomeSectionType
  order    Int
  visible  Boolean         @default(true)
  eyebrow  String?
  title    String?
  body     String?         @db.Text
  imageUrl String? @db.VarChar(500)
  ctaLabel String?
  ctaHref  String? @db.VarChar(500)
  translations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * Surcharges multilingues des textes structurels du front-office. Les valeurs d'origine
 * restent dans le dictionnaire applicatif et servent de repli : la base ne stocke donc que
 * ce que l'administrateur a effectivement personnalisé.
 */
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(191)
  locale    String   @db.VarChar(5)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
}

/** Références réelles affichées sous le hero. Aucun partenaire fictif n'est seedé. */
model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String? @db.VarChar(500)
  websiteUrl String? @db.VarChar(500)
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

model Order {
  id        String @id @default(cuid())
  reference String @unique

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  sourceLang String
  targetLang String
  pages      Int
  delayKey   String
  destinationCountry String
  receivingAuthority String?
  purpose             String              @db.Text
  certificationNeeds  String
  deliveryMethod      String              @default("DIGITAL")
  deliveryAddress     String?             @db.Text
  clientNotes         String?             @db.Text
  legalHold            Boolean             @default(false)
  status     OrderStatus @default(DEMANDE)

  // Snapshot financier — figé à la validation du devis, jamais recalculé rétroactivement.
  totalAmount   Decimal @db.Decimal(10, 3)
  advanceAmount Decimal @db.Decimal(10, 3)
  balanceAmount Decimal @db.Decimal(10, 3)
  advancePaid   Boolean @default(false)
  balancePaid   Boolean @default(false)

  documents     Document[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  actorId   String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Document {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  kind         DocumentKind
  status       DocumentStatus @default(UPLOADED)
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String
  createdAt    DateTime       @default(now())

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  phase       PaymentPhase
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 3)
  currency    String        @default("TND")
  provider    String
  providerRef String        @unique
  /// URL de paiement retournée par le provider. Elle permet de reprendre un paiement PENDING
  /// sans reconstruire une URL à partir d'hypothèses propres au provider.
  checkoutUrl String?       @db.VarChar(1000)
  /// Une seule tentative active par commande/phase/provider. Remis à NULL à la clôture.
  activeKey   String?       @unique @db.VarChar(191)
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  confirmedAt DateTime?

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  user      User?    @relation(fields: [actorId], references: [id])
  action    String
  resource  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resource])
}

/**
 * Outbox transactionnelle : l'événement métier et l'email sont persistés ensemble, puis un
 * worker avec reprise envoie le message. Aucun appel SMTP ne bloque une transaction paiement.
 */
model EmailOutbox {
  id          String              @id @default(cuid())
  recipient   String
  template    String
  subject     String
  payload     Json
  status      EmailDeliveryStatus @default(PENDING)
  attempts    Int                 @default(0)
  availableAt DateTime            @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, availableAt])
}

/**
 * Réglages clé/valeur du site pilotés depuis le backoffice (couleurs du thème, etc.). Seules
 * les valeurs personnalisées sont stockées : l'absence d'une clé = valeur par défaut du code.
 */
model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
