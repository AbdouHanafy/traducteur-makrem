# --- MySQL (Docker, dev local) — voir docker-compose.yml ---
# Valeurs d'exemple uniquement. Générer de vrais mots de passe locaux dans .env
# (jamais commité) avant de lancer `npm run db:up`.
MYSQL_PORT="3307"
MYSQL_DATABASE="makram_arfaoui"
MYSQL_USER="makram_app"
MYSQL_PASSWORD="changeme_dev_only"
MYSQL_ROOT_PASSWORD="changeme_root_dev_only"

# Doit correspondre exactement aux 4 variables MYSQL_* ci-dessus (mêmes user/password/port/db).
DATABASE_URL="mysql://makram_app:changeme_dev_only@localhost:3307/makram_arfaoui"

# Better Auth — secret généré avec `npx auth secret` (ou `openssl rand -base64 32`).
# BETTER_AUTH_SECRET / BETTER_AUTH_URL sont aussi acceptés.
# OBLIGATOIRE en production (32 caractères minimum), sinon l'application refuse de démarrer.
# Générer : openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
REQUIRE_EMAIL_VERIFICATION="false"
# Double authentification (TOTP) obligatoire pour les administrateurs. Doit valoir "true" en production.
REQUIRE_ADMIN_2FA="false"

# SMTP (nodemailer) — notifications email (Phase 2/10).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Maître Makram Arfaoui <contact@makramarfaoui.com>"

# Transport email HTTP (recommandé pour l'outbox). En développement seulement :
# EMAIL_DELIVERY_MODE="log" journalise uniquement destinataire + sujet, jamais le corps.
EMAIL_DELIVERY_MODE="log"
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="Maître Makram Arfaoui <contact@makramarfaoui.com>"

# Secret Bearer long et aléatoire utilisé par le scheduler pour les jobs internes.
JOBS_SECRET=""

# Stockage privé des documents — chemin HORS du webroot (ARCHITECTURE.md §5).
# Ne jamais pointer ceci vers un dossier servi par `public/`.
PRIVATE_STORAGE_ROOT="C:/data/makram-arfaoui/private-storage"

# Service antivirus/CDR : POST des octets bruts, réponse JSON {"clean":true}.
# Obligatoire en production ; sans URL, les uploads sont refusés en mode production.
MALWARE_SCANNER_URL=""
MALWARE_SCANNER_TOKEN=""
MALWARE_SCANNER_TIMEOUT_MS="30000"

# Provider de paiement : mock uniquement en développement, konnect en staging/production.
# Avant le déploiement, utiliser KONNECT_ENV="production" puis exécuter `npm run env:check`.
PAYMENT_PROVIDER="mock"
KONNECT_ENV="sandbox"
# Laisser vide pour utiliser l'URL officielle correspondant à KONNECT_ENV.
KONNECT_API_BASE_URL=""
KONNECT_API_KEY=""
KONNECT_RECEIVER_WALLET_ID=""
KONNECT_PAYMENT_LIFESPAN_MINUTES="30"
